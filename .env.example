# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional override. If omitted, scripts build the standard R2 endpoint from R2_ACCOUNT_ID.
R2_ENDPOINT=

# Local temporary directory for downloaded premium artifacts.
PREMIUM_ARTIFACT_DIR=.cache/premium-plugins
